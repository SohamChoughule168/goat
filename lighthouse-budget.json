{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "startServerCommand": "pnpm start",
      "url": [
        "http://localhost:3000",
        "http://localhost:3000/about",
        "http://localhost:3000/services",
        "http://localhost:3000/work",
        "http://localhost:3000/pricing"
      ],
      "settings": {
        "headless": true,
        "preset": "desktop",
        "staticDistDir": "./.next/server"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 1 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "categories:pwa": ["off"],
        "first-contentful-paint": ["error", { "maxNumericValue": 1500 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 1000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.02 }],
        "interactive": ["error", { "maxNumericValue": 100 }],
        "total-blocking-time": ["error", { "maxNumericValue": 100 }],
        "speed-index": ["error", { "maxNumericValue": 2000 }],
        "first-meaningful-paint": ["error", { "maxNumericValue": 1500 }],
        "redirects": ["off"],
        "uses-rel-preload": ["off"],
        "uses-text-compression": ["warn"],
        "uses-responsive-images": ["warn"],
        "uses-webp-images": ["warn"],
        "efficient-animated-content": ["warn"],
        "duplicated-javascript": ["warn"],
        "legacy-javascript": ["warn"],
        "unminified-css": ["warn"],
        "unminified-javascript": ["warn"],
        "unused-css-rules": ["warn"],
        "unused-javascript": ["warn"],
        "render-blocking-resources": ["warn"],
        "modern-image-formats": ["warn"],
        "offscreen-images": ["warn"],
        "unoptimized-images": ["warn"]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}