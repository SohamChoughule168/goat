{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "trailingSlash": true,
  "buildCommand": "pnpm build",
  "devCommand": "pnpm dev",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "regions": ["iad1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-DNS-Prefetch-Control", "value": "on" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/models/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    { "source": "/portfolio", "destination": "https://www.imaginarsclubservices.com/work/", "permanent": true },
    { "source": "/blog", "destination": "https://www.imaginarsclubservices.com/insights/", "permanent": true },
    { "source": "/blog/:slug", "destination": "https://www.imaginarsclubservices.com/insights/", "permanent": true },
    { "source": "/services/web-dev", "destination": "https://www.imaginarsclubservices.com/services/web-development/", "permanent": true },
    { "source": "/services/mobile", "destination": "https://www.imaginarsclubservices.com/services/mobile-app-development/", "permanent": true },
    { "source": "/services/ai", "destination": "https://www.imaginarsclubservices.com/services/ai-driven-websites/", "permanent": true },
    { "source": "/services/refurbish", "destination": "https://www.imaginarsclubservices.com/services/website-refurbishment/", "permanent": true },
    { "source": "/services/marketing", "destination": "https://www.imaginarsclubservices.com/services/digital-marketing/", "permanent": true },
    { "source": "/services/social-media", "destination": "https://www.imaginarsclubservices.com/services/social-media-marketing/", "permanent": true },
    { "source": "/services/geo", "destination": "https://www.imaginarsclubservices.com/services/generative-engine-optimization/", "permanent": true },
    { "source": "/services/aeo", "destination": "https://www.imaginarsclubservices.com/services/answer-engine-optimization/", "permanent": true },
    { "source": "/services/meta-ads", "destination": "https://www.imaginarsclubservices.com/services/meta-advertising/", "permanent": true },
    { "source": "/services/google-business", "destination": "https://www.imaginarsclubservices.com/services/google-business-profile/", "permanent": true },
    { "source": "/services/brand", "destination": "https://www.imaginarsclubservices.com/services/brand-management/", "permanent": true },
    { "source": "/services/video", "destination": "https://www.imaginarsclubservices.com/services/video-editing/", "permanent": true },
    { "source": "/services/thumbnails", "destination": "https://www.imaginarsclubservices.com/services/thumbnail-design/", "permanent": true },
    { "source": "/services/events", "destination": "https://www.imaginarsclubservices.com/services/online-events/", "permanent": true },
    { "source": "/services/google-ai", "destination": "https://www.imaginarsclubservices.com/services/google-ai-integration/", "permanent": true },
    { "source": "/services/talent", "destination": "https://www.imaginarsclubservices.com/services/talent-acquisition/", "permanent": true }
  ],
  "github": {
    "enabled": true,
    "autoAlias": true,
    "silent": false
  }
}
